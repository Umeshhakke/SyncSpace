# SyncSpace Server Environment Variables (Render.com)
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g., MongoDB Atlas connection string)
# Optional: If omitted or unreachable, the server automatically uses local JSON fallback storage in server/data/
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/syncspace?retryWrites=true&w=majority

# Secret key for signing JWT user authentication tokens
JWT_SECRET=super_secret_jwt_key_replace_me_in_production_2026
